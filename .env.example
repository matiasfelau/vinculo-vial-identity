# Copiar a .env y completar. El .env está en .gitignore y no debe versionarse.
#
# Las cinco claves privadas se generan con:
#
#     go run ./cmd/genkeys
#
# Ese comando imprime además IDENTITY_HPKE_PUBLIC_KEY —la que embebe el
# frontend para cifrar el payload del registro— y JWT_PUBLIC_KEY —la que
# consume el Gateway para verificar los Access Token que firma este servicio—.

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info

# ── Servidor HTTP ─────────────────────────────────────────────────────────────
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
# Tope del cuerpo aceptado. El payload incluye una selfie (hasta 4 MiB
# decodificada); en base64, y vuelta a envolver en base64 como parte del
# ciphertext HPKE, ronda varios megabytes. 10 MiB deja margen sobre ese cálculo.
HTTP_MAX_BODY_BYTES=10485760

# ── Router interno (US-04) ──────────────────────────────────────────────────
# Puerto donde se sirven las rutas /internal/* (p. ej. POST
# /internal/verify-ownership), separado del puerto público. Ni Kong ni el
# docker-compose de este servicio lo publican fuera de la red interna.
HTTP_INTERNAL_PORT=8081

# Secreto compartido de servicio a servicio que vinculo-vial-vehicle debe
# enviar en la cabecera X-Internal-Service-Token en cada llamada a
# /internal/*. Es la segunda capa del aislamiento: la ausencia de una Route en
# Kong no alcanza por sí sola, porque cualquier contenedor de la red Docker
# podría alcanzar igual el puerto interno. Mínimo 32 caracteres.
INTERNAL_SERVICE_TOKEN=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Valor pensado para correr el servicio fuera del contenedor. Dentro de Compose
# lo pisa el nombre del contenedor de la base, vinculo-vial-identity-db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=identity
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=identity
# disable solo vale en local. Con APP_ENV=production la configuración lo rechaza.
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=30m
POSTGRES_CONN_MAX_IDLE_TIME=5m
# statement_timeout del lado del servidor: aborta cualquier sentencia que lo
# exceda, incluso si el contexto del cliente Go no se respetara. Defensa en
# profundidad junto al deadline por consulta del cliente (internal/repository
# /postgres.queryTimeout, mismo valor). /auth/signup encadena RENAPER y una
# escritura en base: 1500ms cada una + margen para Argon2id queda bajo el
# techo de 5000 ms del request completo (contrato de resiliencia).
POSTGRES_STATEMENT_TIMEOUT=1500ms
# Las sentencias llevan los parámetros interpolados, incluidos el DNI cifrado y
# el hash de contraseña. Solo para depuración local.
POSTGRES_LOG_SQL=false
# Borra y recrea el esquema `public` en cada arranque, antes de AutoMigrate,
# para que un despliegue efímero de pruebas E2E siempre levante con una base
# vacía. Destructivo por diseño: la configuración rechaza true junto con
# APP_ENV=production.
EPHEMERAL_DB=false

# ── Criptografía ──────────────────────────────────────────────────────────────
# Cinco claves independientes, una por mecanismo. No reutilizar una para otra:
# comprometer una no debe comprometer las demás, y cada una rota por separado.

# Clave privada HPKE (X25519, base64 de 32 bytes). Descifra el mensaje de
# transporte que envía la app. Es la mitad privada del par cuya pública embebe el
# frontend en IDENTITY_HPKE_PUBLIC_KEY: los dos valores tienen que salir de la
# misma corrida de genkeys.
IDENTITY_HPKE_PRIVATE_KEY=

# Contexto de derivación HPKE (`info` de RFC 9180). Vacío es el valor
# interoperable: el contrato compartido de US-01 no define ninguno, y una
# librería HPKE que no reciba un info explícito usa exactamente esto.
#
# Si el frontend termina cifrando con un info no vacío, hay que replicarlo acá
# byte a byte o el AEAD no autentica y toda alta falla con 500.
IDENTITY_HPKE_INFO=

# Clave del cifrado at-rest del DNI (AES-256-GCM, base64 de 32 bytes).
AES_KEY=

# Secreto del Blind Index del DNI (HMAC-SHA256, base64 de 32 bytes o más).
HMAC_SECRET=

# Clave de los códigos de email de US-13 (HMAC-SHA256, base64 de al menos 32
# bytes). Con ella se guardan el subject y el código de cada desafío: sin ella,
# quien se lleve la tabla email_challenges recuperaría los códigos (son 10^6) y
# los emails por fuerza bruta. Propia de este mecanismo: el servicio no arranca si
# coincide con AES_KEY o HMAC_SECRET. Obligatoria. La genera genkeys.
EMAIL_CODE_HMAC_KEY=

# Argon2id. Cada derivación concurrente reserva ARGON2_MEMORY_KIB: subir este
# valor obliga a acotar la concurrencia del endpoint en la misma proporción.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# Clave privada de firma de los Access Token (RS256, PEM RSA de al menos 2048
# bits). Identity es el único custodio: firma acá y en ningún otro lugar. El
# Gateway y el resto de la plataforma reciben solo la pública correspondiente
# (JWT_PUBLIC_KEY, que genkeys también imprime), para verificar sin poder
# emitir.
#
# El PEM viaja en una sola línea, con los saltos de línea escapados como \n
# literal: el parser de este archivo no interpreta valores multilínea.
# genkeys ya la imprime en este formato, lista para pegar.
JWT_PRIVATE_KEY=

# Claim `iss` (Issuer) del Access Token. Kong lo exige para mapear el token al
# Consumer correcto antes de validar la firma RS256.
JWT_ISSUER=vinculo-vial-identity

# TTL de los tokens de sesión que emite el login (US-02). Los valores del
# contrato compartido son 15 minutos y 30 días: Gateway asume los mismos TTL
# del lado de la verificación, así que no son un ajuste libre de este servicio.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Vida máxima de la sesión desde el inicio de sesión con contraseña (US-12). Al
# pasarla, /auth/refresh responde el mismo 401 que una sesión vencida y el
# usuario tiene que volver a ingresar, por más que el refresh siga rotando.
# REFRESH_TOKEN_TTL_DAYS sigue siendo la inactividad máxima.
SESSION_MAX_DAYS=90

# ── RENAPER ───────────────────────────────────────────────────────────────────
# RENAPER_TIMEOUT acota la única consulta síncrona saliente del servicio
# (conexión y lectura). Hoy internal/renaper.Mock la usa para simular la
# cancelación por contexto; cuando exista el cliente real, el mismo valor pasa
# a acotar su http.Client. /auth/signup encadena RENAPER y una escritura en
# base (ver POSTGRES_STATEMENT_TIMEOUT): request completo ≤ 5000 ms, contrato
# de resiliencia.
RENAPER_TIMEOUT=1500ms

# Circuit breaker hacia RENAPER: se abre tras RENAPER_BREAKER_FAILURE_THRESHOLD
# fallas (timeout, conexión rechazada, 5xx del upstream) dentro de
# RENAPER_BREAKER_WINDOW, y permanece abierto RENAPER_BREAKER_OPEN_DURATION
# antes de admitir una única llamada de prueba. Un rechazo legítimo de RENAPER
# —identidad no confirmada— nunca cuenta como falla.
RENAPER_BREAKER_FAILURE_THRESHOLD=5
RENAPER_BREAKER_WINDOW=1m
RENAPER_BREAKER_OPEN_DURATION=30s

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# El broker es global y no está en el docker-compose de este servicio. En local
# queda deshabilitado y se usa el publisher inerte, que registra en WARN cada
# evento descartado. Con APP_ENV=production, false es rechazado.
#
# RABBITMQ_EXCHANGE debe coincidir exactamente con el exchange que declara
# vinculo-vial-core: este servicio lo verifica con una declaración pasiva y
# falla al arrancar si no existe, nunca lo crea por su cuenta.
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=vvi.topic.exchange
RABBITMQ_PRODUCER=vinculo-vial-identity
# RABBITMQ_PUBLISH_TIMEOUT acota el intento completo de un publish —primer
# intento, reconexión y reintento—. RABBITMQ_DIAL_TIMEOUT es el tope del
# establecimiento de la conexión, pero nunca se usa entero si el publish en
# curso ya consumió parte de su propio plazo: ver la nota de dialWithDeadline
# en internal/delivery/events/publisher.go. Lo consume el worker del
# outbox, fuera del camino de cualquier request: no suma al presupuesto de
# ningún endpoint.
RABBITMQ_PUBLISH_TIMEOUT=1500ms
RABBITMQ_DIAL_TIMEOUT=10s
RABBITMQ_HEARTBEAT=10s

# ── Consumo de eventos (US-08) ────────────────────────────────────────────────
# Rigen para todos los consumidores de este servicio. La conexión con el broker
# es la de RABBITMQ_URL; las colas de trabajo, su cola de reintento y su DLQ las
# declara vinculo-vial-core, nunca este servicio.
#
# Tope de mensajes sin ack que el broker adelanta a cada consumidor
# (basic.qos). Entre 1 y 65535.
RABBITMQ_PREFETCH=10
# Reintentos de un fallo transitorio (por ejemplo, la base caída) antes de
# derivar el mensaje a la DLQ. Un mensaje inválido no se reintenta: va directo
# a la DLQ.
MAX_RETRIES=5

# Cola de trabajo de alert.rejected. La declara vinculo-vial-core junto con su
# cola de reintento y su DLQ; este servicio solo la consume. También identifica
# a este consumidor en la deduplicación (processed_events).
ALERT_REJECTED_QUEUE=identity.alert-rejected.q

# Cola de trabajo de alert.reported. También la declara vinculo-vial-core.
ALERT_REPORTED_QUEUE=identity.alert-reported.q

# ── Reputación (US-08) ────────────────────────────────────────────────────────
# Puntos que se restan a reputation_score por cada alerta rechazada por fraude
# (NO_VEHICLE, BURST_MISMATCH o PLATE_MISMATCH). No puede ser negativo.
FRAUD_PENALTY=10

# Cantidad de reportes que ponen al usuario en revisión (UNDER_REVIEW): sin
# poder enviar alertas, pero con el login, el refresh y el resto de la cuenta
# intactos. Al menos 1. Levantar la revisión es manual: no alcanza con editar
# la base, hay que emitir también user.status.changed con ACTIVE.
REPORT_REVIEW_THRESHOLD=1

# ── Outbox (US-06) ───────────────────────────────────────────────────────────
# Worker en background que publica user.sessions.revoked desde la tabla
# outbox_events, desacoplado del camino síncrono de /refresh (patrón
# Transactional Outbox). No forma parte del presupuesto de ningún request:
# su cadencia es una decisión operativa, no de latencia.
OUTBOX_WORKER_INTERVAL=2s
OUTBOX_WORKER_BATCH_SIZE=20

# ── Baja de cuenta y registro de auditoría (US-11) ───────────────────────────
# Clave pública X25519 de Audit, en base64, y el id corto que la identifica (por
# ejemplo, 2026-11). Con ellas se sella el DNI del emisor de cada alerta (HPKE,
# con el info atado al alert_id): ni este servicio ni quien acceda a la base puede
# volver a leerlo. OBLIGATORIAS: sin ellas el servicio no arranca. Tienen que ser
# iguales a las de Vehicle.
#
# El par lo genera audit-keygen (repo vinculo-vial-audit), fuera de línea y en la
# máquina del responsable legal. La privada NUNCA entra a ningún repo ni la carga
# ningún servicio, ni siquiera Audit. El id admite letras, dígitos, '.', '_' y
# '-', hasta 32 caracteres.
AUDIT_PUBLIC_KEY=
AUDIT_KEY_ID=

# Días que la sanción de una cuenta penalizada que se dio de baja se hereda si el
# mismo DNI se vuelve a registrar (3 años: art. 2561 del CCyC y art. 62 del CP).
# Vencido el plazo, el sweeper la borra (art. 4 inc. 7 de la Ley 25.326). Al menos
# 1.
SANCTION_CARRYOVER_DAYS=1095

# Cada cuánto corre el sweeper que borra las sanciones vencidas, y cuántas borra
# por sentencia. El plazo es de años: borrar con una hora de demora no cambia
# nada. En local se puede bajar SANCTION_CARRYOVER_DAYS y este intervalo para ver
# el barrido funcionando.
SANCTION_CARRYOVER_SWEEP_INTERVAL=1h
SANCTION_CARRYOVER_SWEEP_BATCH_SIZE=500

# ── Verificación de email y recuperación de contraseña (US-13) ───────────────
# Los valores son los del contrato de la etapa 1. Los mails los envía
# Notification a partir de email.requested.
#
# Vida del código que llega por email, y cuántos intentos admite antes de exigir
# uno nuevo.
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5

# Throttle de envíos por subject (un email, o una cuenta en la recuperación):
# mínimo entre dos envíos, y tope en una ventana de 24 h. Pasados los límites, el
# pedido responde igual 202 pero no envía. EMAIL_CODE_RESEND_SECONDS tiene que
# coincidir con el del Frontend, que lo usa en la cuenta regresiva del botón
# "Reenviar".
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_SENDS_PER_DAY=5

# Vida de los tokens que emite la confirmación del código: el que consume el alta
# y el reset_token de la recuperación.
EMAIL_VERIFICATION_GRANT_TTL_MINUTES=30
PASSWORD_RESET_GRANT_TTL_MINUTES=15

# Rechazos de identidad (DNI escaneado ajeno, o RENAPER que no confirma) que admite
# un reset_token antes de quedar inválido. Una dependencia caída no descuenta.
PASSWORD_RESET_MAX_IDENTITY_ATTEMPTS=3

# Exige el token de verificación de email en el alta. En false, el alta no lo
# exige: existe solo para no romper el alta en desarrollo hasta que el Frontend lo
# envíe. La configuración rechaza false con APP_ENV=production.
SIGNUP_REQUIRE_EMAIL_VERIFICATION=true

# Cada cuánto corre el sweeper que borra los desafíos vencidos (código, grant y
# ventana de envíos ya pasados), y cuántos borra por sentencia.
EMAIL_CHALLENGE_SWEEP_INTERVAL=1h
EMAIL_CHALLENGE_SWEEP_BATCH_SIZE=500
