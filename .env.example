# Copiar a .env y completar. El .env está en .gitignore y no debe versionarse.
#
# Las tres claves criptográficas se generan con:
#
#     go run ./cmd/genkeys
#
# Ese comando imprime además HPKE_PUBLIC_KEY, la única clave que sale del
# servicio: es la que embebe la app Android para cifrar el payload del registro.

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info

# ── Servidor HTTP ─────────────────────────────────────────────────────────────
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
# Tope del cuerpo aceptado. El criptograma de un alta ronda los cientos de bytes.
HTTP_MAX_BODY_BYTES=8192

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=identity
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=identity
# disable solo vale en local. Con APP_ENV=production la configuración lo rechaza.
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=30m
POSTGRES_CONN_MAX_IDLE_TIME=5m
# Las sentencias llevan los parámetros interpolados, incluidos el DNI cifrado y
# el hash de contraseña. Solo para depuración local.
POSTGRES_LOG_SQL=false

# ── Criptografía ──────────────────────────────────────────────────────────────
# Tres claves independientes, una por mecanismo. No reutilizar una para otra:
# comprometer una no debe comprometer las demás, y cada una rota por separado.

# Clave privada HPKE (X25519, base64 de 32 bytes). Descifra el criptograma de
# transporte que envía la app.
HPKE_PRIVATE_KEY=

# Contexto de derivación HPKE. Debe coincidir byte a byte con el contextInfo que
# usa el cliente Tink en Android; si difiere, el descifrado falla.
HPKE_INFO=vinculo-vial/identity/signup/v1

# Clave del cifrado at-rest del DNI (AES-256-GCM, base64 de 32 bytes).
AES_KEY=

# Secreto del Blind Index del DNI (HMAC-SHA256, base64 de 32 bytes o más).
HMAC_SECRET=

# Argon2id. Cada derivación concurrente reserva ARGON2_MEMORY_KIB: subir este
# valor obliga a acotar la concurrencia del endpoint en la misma proporción.
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# El broker es global y no está en el docker-compose de este servicio. En local
# queda deshabilitado y se usa el publisher inerte, que registra en WARN cada
# evento descartado. Con APP_ENV=production, false es rechazado.
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=vinculo-vial.events
RABBITMQ_PRODUCER=vinculo-vial-identity
RABBITMQ_PUBLISH_TIMEOUT=5s
